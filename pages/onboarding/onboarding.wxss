.onboarding-page {
  background: linear-gradient(180deg, #fbf5ff 0%, #fff4fb 48%, #f3f8ff 100%);
}

.soft-bg {
  position: absolute;
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  opacity: 0.45;
}

.soft-bg-a {
  top: 90rpx;
  right: -120rpx;
  background: #f1c8ff;
}

.soft-bg-b {
  bottom: 120rpx;
  left: -140rpx;
  background: #cfe3ff;
}

.onboarding-shell {
  padding-left: 40rpx;
  padding-right: 40rpx;
}

.hero {
  text-align: center;
  margin-bottom: 44rpx;
}

.eyebrow {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  color: #9b72e8;
  font-size: 26rpx;
  margin-bottom: 20rpx;
}

.eyebrow-mark {
  font-size: 30rpx;
  line-height: 1;
}

.hero-title {
  display: block;
  color: #272033;
  font-size: 58rpx;
  font-weight: 600;
  line-height: 1.18;
  margin-bottom: 18rpx;
}

.hero-subtitle {
  color: #7e768b;
  font-size: 26rpx;
}

.role-carousel {
  width: 100%;
  white-space: nowrap;
  overflow: visible;
}

.role-track {
  display: inline-flex;
  gap: 28rpx;
  padding: 10rpx 64rpx 28rpx;
}

.role-card {
  position: relative;
  display: inline-flex;
  width: 560rpx;
  height: 800rpx;
  overflow: hidden;
  border-radius: 42rpx;
  background: #ffffff;
  box-shadow: 0 20rpx 50rpx rgba(116, 92, 148, 0.16);
  transform: scale(0.92);
  opacity: 0.58;
  transition: transform 180ms ease, opacity 180ms ease;
}

.role-card-active {
  transform: scale(1);
  opacity: 1;
}

.role-card-bg,
.role-card-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.role-card-bg {
  opacity: 0.34;
}

.role-card-mask {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.58), rgba(255, 255, 255, 0.42) 46%, rgba(255, 255, 255, 0.88));
}

.role-card-content {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
  padding: 86rpx 54rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.role-avatar {
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  border: 8rpx solid #ffffff;
  box-shadow: 0 22rpx 44rpx rgba(80, 57, 109, 0.22);
  margin-bottom: 42rpx;
}

.role-name {
  color: #272033;
  font-size: 46rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.role-desc {
  color: #6f667b;
  font-size: 27rpx;
  line-height: 1.7;
  white-space: normal;
}

.dots {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  margin: 18rpx 0 44rpx;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background: #d7d0df;
}

.dot-active {
  width: 58rpx;
  background: linear-gradient(90deg, #9d6ef1, #ff7eb6);
}

.primary-button,
.login-button {
  width: 100%;
  height: 96rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  background: linear-gradient(90deg, #8d63ea, #ff6eaa);
  box-shadow: 0 18rpx 36rpx rgba(170, 89, 198, 0.28);
}

.modal-layer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.modal-backdrop {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(28, 20, 40, 0.48);
}

.login-modal {
  position: relative;
  z-index: 1;
  width: 100%;
  overflow: hidden;
  border-radius: 40rpx;
  background: #ffffff;
  box-shadow: 0 28rpx 72rpx rgba(33, 23, 50, 0.28);
}

.modal-close {
  position: absolute;
  z-index: 2;
  top: 24rpx;
  right: 24rpx;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.86);
  color: #736978;
  font-size: 44rpx;
  line-height: 52rpx;
}

.login-header {
  padding: 52rpx 48rpx 44rpx;
  text-align: center;
  background: linear-gradient(135deg, #fbf4ff, #fff0f8);
}

.login-eyebrow {
  margin-bottom: 16rpx;
}

.login-title {
  display: block;
  color: #272033;
  font-size: 44rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.login-subtitle {
  color: #81788c;
  font-size: 26rpx;
}

.form-block {
  padding: 0 48rpx;
  margin-top: 30rpx;
}

.field-label {
  display: block;
  color: #4f4859;
  font-size: 27rpx;
  margin-bottom: 14rpx;
}

.phone-row,
.code-row {
  display: flex;
  gap: 20rpx;
}

.country-code,
.field-input,
.code-button {
  min-height: 88rpx;
  border-radius: 22rpx;
  border: 1rpx solid #e8e2ed;
  background: #f8f6fa;
}

.country-code {
  width: 132rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #2f2938;
  font-size: 28rpx;
}

.field-input {
  flex: 1;
  padding: 0 28rpx;
  color: #292333;
  font-size: 28rpx;
}

.code-button {
  width: 190rpx;
  color: #8658d8;
  font-size: 26rpx;
  background: #f5edff;
}

.error-text {
  display: block;
  padding: 24rpx 48rpx 0;
  color: #d94b63;
  font-size: 25rpx;
}

.login-button {
  width: calc(100% - 96rpx);
  margin: 36rpx 48rpx 22rpx;
  border-radius: 24rpx;
}

.agreement {
  display: block;
  padding: 0 48rpx 42rpx;
  color: #aaa2b2;
  font-size: 22rpx;
  text-align: center;
  line-height: 1.7;
}
