<view class="app-page chat-page">
  <image class="chat-bg" src="{{role.backgroundUrl}}" mode="aspectFill"></image>
  <view class="chat-bg-mask"></view>

  <view class="chat-shell">
    <view class="chat-nav">
      <button class="nav-button" bindtap="goBack">‹</button>
      <image class="nav-avatar" src="{{role.avatarUrl}}" mode="aspectFill"></image>
      <view class="nav-info">
        <text class="nav-name">{{role.nickname}}</text>
        <text class="nav-tag text-ellipsis">{{role.tag}}</text>
      </view>
      <button class="nav-button" bindtap="clearCurrentHistory">⋯</button>
    </view>

    <scroll-view
      class="message-scroll"
      scroll-y
      enhanced
      show-scrollbar="{{false}}"
      scroll-into-view="{{scrollIntoView}}"
    >
      <view class="message-list">
        <view wx:if="{{loadingHistory}}" class="loading-text">正在加载聊天记录...</view>

        <view
          wx:for="{{messages}}"
          wx:key="id"
          class="message-row {{item.sender == 'user' ? 'message-row-user' : 'message-row-assistant'}}"
        >
          <image
            wx:if="{{item.sender != 'user'}}"
            class="message-avatar"
            src="{{role.avatarUrl}}"
            mode="aspectFill"
          ></image>
          <view class="message-bubble {{item.sender == 'user' ? 'bubble-user' : 'bubble-assistant'}}">
            <image
              wx:if="{{item.imagePath}}"
              class="bubble-image"
              src="{{item.imagePath}}"
              mode="aspectFill"
              bindtap="previewMessageImage"
              data-src="{{item.imagePath}}"
            ></image>
            <text wx:if="{{item.content}}" class="message-text">{{item.content}}</text>
          </view>
        </view>

        <view wx:if="{{sending}}" class="message-row message-row-assistant">
          <image class="message-avatar" src="{{role.avatarUrl}}" mode="aspectFill"></image>
          <view class="message-bubble bubble-assistant typing-bubble">
            <text>正在回复...</text>
          </view>
        </view>

        <view id="bottom-anchor" class="bottom-anchor"></view>
      </view>
    </scroll-view>

    <view class="quick-topic-wrap">
      <scroll-view class="quick-topic-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="quick-topic-track">
          <button
            wx:for="{{quickTopics}}"
            wx:key="*this"
            class="topic-pill"
            bindtap="useQuickTopic"
            data-topic="{{item}}"
          >
            {{item}}
          </button>
        </view>
      </scroll-view>
    </view>

    <view wx:if="{{selectedImage}}" class="selected-image-panel">
      <image class="selected-image" src="{{selectedImage.tempFilePath}}" mode="aspectFill" bindtap="previewSelectedImage"></image>
      <view class="selected-image-meta">
        <text class="selected-image-title">已选择图片</text>
        <text class="selected-image-subtitle">可补充文字一起发送</text>
      </view>
      <button class="remove-image-button" bindtap="removeSelectedImage">×</button>
    </view>

    <view class="input-bar">
      <button class="image-button" bindtap="chooseImage" loading="{{convertingImage}}" disabled="{{sending || convertingImage}}">
        图
      </button>
      <view class="input-shell">
        <textarea
          class="chat-input"
          value="{{inputValue}}"
          placeholder="说点什么..."
          auto-height="{{true}}"
          maxlength="10000"
          cursor-spacing="22"
          adjust-position="{{true}}"
          show-confirm-bar="{{false}}"
          hold-keyboard="{{true}}"
          bindinput="onInput"
        ></textarea>
      </view>
      <button class="send-button {{canSend ? 'send-button-active' : ''}}" bindtap="sendMessage" disabled="{{!canSend || sending || convertingImage}}">
        发
      </button>
    </view>
  </view>
</view>
