.chat-page {
  background: #f5f0fb;
  height: 100vh;
  overflow: hidden;
}

.chat-bg,
.chat-bg-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.chat-bg {
  opacity: 0.5;
}

.chat-bg-mask {
  background: rgba(255, 255, 255, 0.38);
}

.chat-shell {
  position: relative;
  z-index: 2;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.chat-nav {
  padding: 66rpx 24rpx 18rpx;
  min-height: 154rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: rgba(255, 255, 255, 0.9);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.72);
}

.nav-button {
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  text-align: center;
  border-radius: 50%;
  color: #4a4254;
  font-size: 48rpx;
  background: #f1eef5;
  flex-shrink: 0;
}

.nav-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 4rpx solid #ffffff;
  flex-shrink: 0;
}

.nav-info {
  flex: 1;
  min-width: 0;
}

.nav-name {
  display: block;
  color: #282132;
  font-size: 31rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.nav-tag {
  display: block;
  color: #7e748a;
  font-size: 23rpx;
}

.message-scroll {
  flex: 1;
  min-height: 0;
  height: auto;
}

.message-list {
  padding: 26rpx 24rpx 20rpx;
}

.loading-text {
  padding: 28rpx;
  color: #7d738a;
  font-size: 24rpx;
  text-align: center;
}

.message-row {
  display: flex;
  gap: 14rpx;
  margin-bottom: 22rpx;
}

.message-row-user {
  justify-content: flex-end;
}

.message-row-assistant {
  justify-content: flex-start;
}

.message-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 8rpx;
}

.message-bubble {
  max-width: 540rpx;
  padding: 18rpx 24rpx;
  border-radius: 26rpx;
  font-size: 28rpx;
  line-height: 1.58;
  word-break: break-all;
}

.message-text {
  display: block;
}

.bubble-image {
  width: 300rpx;
  height: 220rpx;
  border-radius: 20rpx;
  margin-bottom: 12rpx;
  background: rgba(255, 255, 255, 0.35);
}

.bubble-user {
  color: #ffffff;
  border-bottom-right-radius: 8rpx;
  background: linear-gradient(90deg, #8d63ea, #ff6eaa);
  box-shadow: 0 12rpx 24rpx rgba(156, 92, 200, 0.22);
}

.bubble-assistant {
  color: #3c3348;
  border-bottom-left-radius: 8rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 10rpx 22rpx rgba(63, 48, 82, 0.1);
}

.typing-bubble {
  color: #8a8195;
}

.bottom-anchor {
  height: 8rpx;
}

.quick-topic-wrap {
  padding: 8rpx 24rpx 12rpx;
  flex-shrink: 0;
}

.selected-image-panel {
  margin: 0 24rpx 12rpx;
  padding: 14rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 8rpx 18rpx rgba(58, 43, 76, 0.08);
  flex-shrink: 0;
}

.selected-image {
  width: 104rpx;
  height: 104rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
}

.selected-image-meta {
  flex: 1;
  min-width: 0;
}

.selected-image-title {
  display: block;
  color: #30283b;
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.selected-image-subtitle {
  display: block;
  color: #8a8195;
  font-size: 22rpx;
}

.remove-image-button {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  color: #7c7289;
  font-size: 30rpx;
  background: #f1eef5;
  flex-shrink: 0;
}

.quick-topic-scroll {
  white-space: nowrap;
}

.quick-topic-track {
  display: flex;
  gap: 16rpx;
  min-width: 100%;
}

.topic-pill {
  display: flex;
  height: 64rpx;
  align-items: center;
  padding: 0 26rpx;
  border-radius: 999rpx;
  color: #5c5267;
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(224, 216, 232, 0.9);
  box-shadow: 0 8rpx 18rpx rgba(58, 43, 76, 0.08);
  flex-shrink: 0;
}

.input-bar {
  padding: 18rpx 20rpx 30rpx;
  display: flex;
  align-items: flex-end;
  gap: 14rpx;
  background: rgba(255, 255, 255, 0.86);
  border-top: 1rpx solid rgba(230, 224, 236, 0.72);
  flex-shrink: 0;
}

.image-button {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  color: #805bd4;
  font-size: 26rpx;
  font-weight: 600;
  background: #f1eef5;
  flex-shrink: 0;
}

.input-shell {
  flex: 1;
  min-width: 0;
  min-height: 96rpx;
  max-height: 188rpx;
  padding: 20rpx 28rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  background: #f1eef5;
}

.chat-input {
  width: 100%;
  min-height: 56rpx;
  max-height: 148rpx;
  line-height: 40rpx;
  color: #30283b;
  font-size: 28rpx;
  background: transparent;
}

.send-button {
  width: 80rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 50%;
  color: #a59dac;
  font-size: 27rpx;
  font-weight: 600;
  background: #d8d2df;
  flex-shrink: 0;
}

.send-button-active {
  color: #ffffff;
  background: linear-gradient(135deg, #8d63ea, #ff6eaa);
  box-shadow: 0 12rpx 24rpx rgba(156, 92, 200, 0.22);
}
