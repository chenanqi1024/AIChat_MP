page {
  min-height: 100vh;
  background: #fbf7ff;
  color: #252131;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
}

view,
text,
scroll-view,
input,
button,
image {
  box-sizing: border-box;
}

button {
  padding: 0;
  margin: 0;
  line-height: 1.4;
  background: transparent;
  border: 0;
  border-radius: 0;
}

button::after {
  border: 0;
}

image {
  display: block;
}

.app-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
}

.safe-shell {
  position: relative;
  z-index: 2;
  min-height: 100vh;
  padding-top: calc(env(safe-area-inset-top) + 48rpx);
  padding-bottom: calc(env(safe-area-inset-bottom) + 32rpx);
}

.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.line-clamp-2 {
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
